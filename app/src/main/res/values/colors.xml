<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ============================================================
         SKENATRACK — Color Palette
         Primary  : Steel Blue  (#1E7FA6 / #145F80)
         Accent   : Golden      (#F5A623 / #C8860A)
         ============================================================ -->

    <!-- Primary: Steel Blue -->
    <color name="blue_primary">#FF1E7FA6</color>
    <color name="blue_dark">#FF145F80</color>
    <color name="blue_light">#FF4BA3C7</color>

    <!-- Accent: Golden / Amber -->
    <color name="gold_primary">#FFF5A623</color>
    <color name="gold_dark">#FFC8860A</color>
    <color name="gold_light">#FFFFD060</color>

    <!-- Alias agar tidak perlu ubah kode Java (backward compat) -->
    <color name="purple_500">@color/blue_primary</color>
    <color name="purple_700">@color/blue_dark</color>

    <!-- Surfaces: light blue-tinted neutral -->
    <color name="surface">#FFF4F8FB</color>
    <color name="white">#FFFCFEFF</color>

    <!-- Text: blue-steel tinted neutrals -->
    <color name="text_primary">#FF0D1F2D</color>
    <color name="text_secondary">#FF4A6572</color>
    <color name="text_hint">#FF8AAAB8</color>

    <!-- UI elements -->
    <color name="divider">#FFD0E4ED</color>
    <color name="error_red">#FFD32F2F</color>

    <!-- Splash gradient: biru tua → emas -->
    <color name="splash_dark">#FF0D3B52</color>
    <color name="splash_mid">#FF1E7FA6</color>
    <color name="splash_light">#FFF5A623</color>
</resources>
